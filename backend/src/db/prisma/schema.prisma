generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DB_URL")
}

enum Role {
  IMPORTER
  EXPORTER
  BROKER
  BANK
  CUSTOMS
  ADMIN
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TransactionType {
  SUBSCRIPTION
  ESCROW
  COMMISSION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DocumentType {
  INVOICE
  BILL_OF_LADING
  CUSTOMS_DECLARATION
  PACKING_LIST
  CERTIFICATE_OF_ORIGIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id                 Int       @id @default(autoincrement())
  owner_name         String
  business_email     String    @unique
  password           String
  role               Role
  company_name       String?
  phone              String?
  address            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  shipmentsCreated   Shipment[]   @relation("ShipmentCreator")
  shipmentsHandled   Shipment[]   @relation("ShipmentBroker")
  transactions       Transaction[]
  documents          Document[]
  servicesOffered    MarketplaceService[] @relation("BrokerServices")
  bookings           Booking[]            @relation("UserBookings")
  
}

model Shipment {
    id            Int            @id @default(autoincrement())
  trackingId      String         @unique
  description     String?
  origin          String
  destination     String
  status          ShipmentStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Coordinates for live tracking
  currentLat      Float?
  currentLng      Float?

  // Relations
  exporter        User       @relation("ShipmentCreator", fields: [exporterId], references: [id])
  exporterId      Int
  broker          User?      @relation("ShipmentBroker", fields: [brokerId], references: [id])
  brokerId        Int?

  documents       Document[]
  transactions    Transaction[]
}

model Transaction {
  id              Int        @id @default(autoincrement())
  type            TransactionType
  amount          Float
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  shipment        Shipment?  @relation(fields: [shipmentId], references: [id])
  shipmentId      Int?
  user            User       @relation(fields: [userId], references: [id])
  userId          Int
}

model Document {
  id              Int        @id @default(autoincrement())
  type            DocumentType
  fileUrl         String
  createdAt       DateTime   @default(now())

  // Relations
  shipment        Shipment?  @relation(fields: [shipmentId], references: [id])
  shipmentId      Int?
  user            User       @relation(fields: [userId], references: [id])
  userId          Int
}


model MarketplaceService {
  id              Int        @id @default(autoincrement())
  name            String
  description     String?
  price           Float
  commissionRate  Float      @default(0.05)
  rating          Float?     @default(0)
  createdAt       DateTime   @default(now())

  // Relations
  broker          User       @relation("BrokerServices", fields: [brokerId], references: [id])
  brokerId        Int
  bookings        Booking[]
}

model Booking {
  id              Int        @id @default(autoincrement())
  service         MarketplaceService @relation(fields: [serviceId], references: [id])
  serviceId       Int
  user            User       @relation("UserBookings", fields: [userId], references: [id])
  userId          Int
  status          BookingStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}