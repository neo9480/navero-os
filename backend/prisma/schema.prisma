generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  SUPER_ADMIN
  ADMIN
  IMPORTER
  EXPORTER
  LOGISTICS_PROVIDER
  BANK
  BROKER
  CUSTOMS
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  AIRWAY_BILL
  CERTIFICATE_OF_ORIGIN
  INSURANCE_CERTIFICATE
  EXPORT_DECLARATION
  IMPORT_DECLARATION
  CUSTOMS_CLEARANCE
  PAYMENT_RECEIPT
  OTHER
}

enum LCStatus {
  APPLIED
  APPROVED
  REJECTED
  ACTIVE
  CLOSED
}

enum ShipmentStatus {
  CREATED
  IN_TRANSIT
  CUSTOMS_HOLD
  CLEARED
  DELIVERED
}

enum ShipmentEventType {
  CUSTOMS_CHECK
  DOCUMENT_VERIFIED
  RELEASED
  DELAYED
  ARRIVED
}

enum TransactionType {
  SERVICE_PAYMENT
  BOOKING_PAYMENT
  LC_FEE
  SHIPMENT_FEE
  SUBSCRIPTION_FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionDirection {
  DEBIT // money going OUT from user
  CREDIT // money coming IN to user
}

enum TransactionReference {
  SHIPMENT
  BOOKING
  LC
  SERVICE
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

//////////////////////////////
// MODELS
//////////////////////////////

// Core users of the platform
model User {
  id           String   @id @default(cuid())
  role         UserRole
  email        String   @unique
  passwordHash String
  companyName  String?
  phone        String?  @unique
  address      String?
  country      String?
  verified      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Document relations (must match names exactly)
  uploadedDocuments Document[] @relation("UploadedDocuments")
  verifiedDocuments Document[] @relation("VerifiedDocuments")

  // Everything else stays unchanged...
  services                  Service[]
  quoteRequests             QuoteRequest[]  @relation("ImporterQuoteRequests")
  quoteResponses            QuoteResponse[]
  lettersOfCreditAsImporter LC[]            @relation("ImporterLC")
  lettersOfCreditAsExporter LC[]            @relation("ExporterLC")
  lettersOfCreditAsBank     LC[]            @relation("BankLC")
  shipmentsAsImporter       Shipment[]      @relation("ImporterShipments")
  shipmentsAsExporter       Shipment[]      @relation("ExporterShipments")
  shipmentsAsBroker         Shipment[]      @relation("BrokerShipments")
  shipmentEvents            ShipmentEvent[]
  notifications              Notification[]
  session                   Session[]
  transactions              Transaction[]
  bookings                  Booking[]
  otp                       OTP[]
  subscription              Subscription?
}

// Services created by brokers or freight providers
model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  providerId  String

  provider User @relation(fields: [providerId], references: [id])

  // ADD THIS
  shipments Shipment[]
  bookings  Booking[]

  createdAt DateTime @default(now())
}

// Importer creates a quote request
model QuoteRequest {
  id            String   @id @default(cuid())
  importerId    String
  productName   String
  quantity      Int
  unit          String?
  incoterm      String?
  originCountry String?
  destCountry   String?
  createdAt     DateTime @default(now())

  importer  User            @relation("ImporterQuoteRequests", fields: [importerId], references: [id])
  responses QuoteResponse[]
}

// Exporters respond to quote requests
model QuoteResponse {
  id             String   @id @default(cuid())
  quoteRequestId String
  exporterId     String
  price          Float
  validityDays   Int?
  notes          String?
  createdAt      DateTime @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])
  exporter     User         @relation(fields: [exporterId], references: [id])
}

// Letter of Credit (Importer → Bank → Exporter)
model LC {
  id        String   @id @default(cuid())
  lcNumber  String   @unique
  amount    Float
  currency  String
  status    LCStatus @default(APPLIED)
  createdAt DateTime @default(now())

  importerId String
  exporterId String
  bankId     String

  importer User @relation("ImporterLC", fields: [importerId], references: [id])
  exporter User @relation("ExporterLC", fields: [exporterId], references: [id])
  bank     User @relation("BankLC", fields: [bankId], references: [id])

  documents Document[] @relation("LC_Documents")
}

// Shipments (Exporter → Importer, handled by broker and services)
model Shipment {
  id         String         @id @default(cuid())
  status     ShipmentStatus @default(CREATED)
  vesselName String?
  airwayBill String?
  etd        DateTime?
  eta        DateTime?
  createdAt  DateTime       @default(now())

  importerId String
  exporterId String
  brokerId   String?
  serviceId  String?

  importer User     @relation("ImporterShipments", fields: [importerId], references: [id])
  exporter User     @relation("ExporterShipments", fields: [exporterId], references: [id])
  broker   User?    @relation("BrokerShipments", fields: [brokerId], references: [id])
  service  Service? @relation(fields: [serviceId], references: [id])

  documents Document[]
  events    ShipmentEvent[]
}

// Events emitted by customs or system for tracking
model ShipmentEvent {
  id         String            @id @default(cuid())
  shipmentId String
  userId     String?
  type       ShipmentEventType
  message    String?
  createdAt  DateTime          @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
}

// Trade documents
model Document {
  id        String       @id @default(cuid())
  type      DocumentType
  fileUrl   String
  verified  Boolean      @default(false)
  createdAt DateTime     @default(now())

  // Relations
  uploadedById String
  verifiedById  String?
  shipmentId   String?
  lcId         String?

  // Properly named relations
  uploadedBy User  @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  verifiedBy  User? @relation("VerifiedDocuments", fields: [verifiedById], references: [id])

  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  lc       LC?       @relation("LC_Documents", fields: [lcId], references: [id])
}

// In-app notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Refresh tokens for login sessions
model Session {
  id                String   @id @default(cuid())
  userId            String
  refreshToken      String   @unique
  ip                String
  userAgent         String
  revoked           Boolean  @default(false)
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  

  user User @relation(fields: [userId], references: [id])
}

model Transaction {
  id            String                @id @default(uuid())
  userId        String
  amount        Float
  type          TransactionType
  direction     TransactionDirection
  status        TransactionStatus     @default(PENDING)
  referenceId   String?
  referenceType TransactionReference?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  serviceId String
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
}

model DailyStats {
  id                String   @id @default(cuid())
  date              DateTime @unique // snapshot date (midnight)
  usersTotal        Int
  usersNew          Int
  shipmentsTotal    Int
  shipmentsNew      Int
  bookingsTotal     Int
  bookingsNew       Int
  servicesTotal     Int
  servicesNew       Int
  transactionsTotal Int
  transactionsNew   Int
  revenueTotal      Float    @default(0) // cumulative revenue up-to-date
  revenueNew        Float    @default(0) // revenue in that day
  createdAt         DateTime @default(now())
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  plan                   String
  status                 SubscriptionStatus @default(TRIALING)
  startedAt              DateTime?          @default(now())
  trialEndsAt            DateTime?
  currentPeriodEndsAt    DateTime?
  providerCustomerId     String? // e.g., Stripe customer id
  providerSubscriptionId String? // e.g., Stripe subscription id
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model OTP {
  id  String  @id @default(cuid()) 
  userId  String  
  email String  
  otpHash String  
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}